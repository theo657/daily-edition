  "_block_comment": "Blocked items are dropped before clustering and never reach the edition at any score. A term in 'unless' reprieves the item, which is how genuinely political stories survive a personality-based block.",

  "block": [
    {
      "_why": "Royal-family personality coverage. Constitutional, fiscal, or criminal stories are reprieved by the unless list.",
      "terms": [
        "prince harry", "meghan", "duchess of sussex", "duke of sussex", "the sussexes",
        "prince william", "kate middleton", "princess of wales", "royal family", "the royals",
        "buckingham palace", "kensington palace", "clarence house", "balmoral", "sandringham",
        "king charles", "queen camilla", "prince andrew", "princess anne", "prince edward",
        "royal source", "royal expert", "royal biographer", "royal correspondent", "royal tour"
      ],
      "unless": [
        "succession to the crown", "constitutional", "head of state", "republic referendum",
        "abolish the monarchy", "sovereign grant", "civil list", "duchy of cornwall",
        "duchy of lancaster", "commonwealth realm", "tax", "inquiry", "police investigation",
        "court ruling", "legislation", "parliament", "prorogation", "royal assent", "extradition"
      ]
    }
